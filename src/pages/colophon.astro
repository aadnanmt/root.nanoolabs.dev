---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import { IconColophon } from '@lib/icon'
import { gitDate } from '@lib/utils'
import FormattedDate from '@components/FormattedDate.astro'
import { COLOPHON } from '@consts'
import { Content } from '@data/colophon.md'

const lastUpdated = gitDate('src/data/colophon.md')
---

<PageLayout title={COLOPHON.TITLE} description={COLOPHON.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>

      <h1 class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconColophon} />
        </div>
        Colophon
      </h1>
      {COLOPHON.INTRO!.map((paragraph) => <p>{paragraph}</p>)}

      {
        lastUpdated && (
          <div class="text-mute-light dark:text-mute-dark text-sm italic">
            Last updated: <FormattedDate date={lastUpdated} />
          </div>
        )
      }

      <article>
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>
