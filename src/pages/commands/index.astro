---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import ArrowCard from '@components/ArrowCard.astro'
import PageTitle from '@components/PageTitle.astro'
import PageIntro from '@components/PageIntro.astro'
import { COMMANDS } from '@consts'
import BackToPrev from '@components/BackToPrev.astro'

const commands = (await getCollection('commands')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
)
---

<PageLayout title={COMMANDS.TITLE} description={COMMANDS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <PageTitle title={COMMANDS.TITLE} />
      <PageIntro intro={COMMANDS.INTRO!} />
      <div class="space-y-4">
        <ul class="flex flex-col gap-3">
          {
            commands.map((command) => (
              <li>
                <ArrowCard entry={command} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</PageLayout>
