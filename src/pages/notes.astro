---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import PageTitle from '@components/PageTitle.astro'
import PageIntro from '@components/PageIntro.astro'
import { NOTES } from '@consts'
import { getPublishedEntries, groupByDate } from '@lib/content'

const notes = getPublishedEntries(await getCollection('notes'))
const grouped = groupByDate(notes)
---

<PageLayout title={NOTES.TITLE} description={NOTES.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <PageTitle title={NOTES.TITLE} />
      <PageIntro intro={NOTES.INTRO!} />
      <div>
        {
          Object.entries(grouped).map(([date, dayNotes]) => (
            <section class="border-border-light border-b py-6 last:border-0">
              <time
                class="text-body-light dark:text-body-dark font-mono text-sm font-semibold whitespace-nowrap"
                datetime={date}
              >
                {date}
              </time>
              <div class="mt-3 space-y-4">
                {dayNotes.map(async (note) => {
                  const { Content } = await note.render()
                  return (
                    <article class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                      <div class="flex items-baseline gap-2 sm:w-16 sm:shrink-0 sm:pt-1">
                        <span class="text-mute-light dark:text-mute-dark font-mono text-xs">
                          {String(dayNotes.indexOf(note) + 1).padStart(2, '0')}
                        </span>
                        <span aria-hidden="true">{note.data.mood ?? ''}</span>
                      </div>
                      <div class="min-w-0">
                        <Content />
                      </div>
                    </article>
                  )
                })}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
