---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import { IconStats } from '@lib/icon'
import Link from '@components/Link.astro'
import NowPlaying from '@components/NowPlaying.astro'
import ProgressBar from '@components/ProgressBar.astro'
import { STATS } from '@consts'

// Fetch local collection count
const allBlog = await getCollection('blog', ({ data }) => !data.draft)
const allCommands = await getCollection('commands')
const allProjects = await getCollection('projects', ({ data }) => !data.draft)

const gardenStats = [
  { name: 'Blog Posts', count: allBlog.length },
  { name: 'Commands', count: allCommands.length },
  { name: 'Projects', count: allProjects.length },
]

interface Language {
  name: string
  percentage: string
}

interface Stats {
  totalCommits: number
  totalFollowers: number
  streak: number
  repoCount: number
  totalDiskUsage: number
  mainLicense: string
  languages: Language[]
  updatedAt?: string
}

const STATS_URL = 'https://raw.githubusercontent.com/aadnanmt/aadnanmt/main/stats.json'
const STATS_TTL = 5 * 60 * 1000

const EMPTY_STATS: Stats = {
  totalCommits: 0,
  totalFollowers: 0,
  streak: 0,
  repoCount: 0,
  totalDiskUsage: 0,
  mainLicense: 'n/a',
  languages: [],
}

let cache: Stats | null = null
let fetchAt = 0

async function getStats(): Promise<Stats> {
  if (cache && Date.now() - fetchAt < STATS_TTL) return cache

  try {
    const response = await fetch(STATS_URL, { signal: AbortSignal.timeout(10000) })
    if (!response.ok) throw new Error(`stats fetch: ${response.status}`)
    const data = await response.json()
    cache = {
      totalCommits: data.totalCommits ?? 0,
      totalFollowers: data.totalFollowers ?? 0,
      streak: data.streak ?? 0,
      repoCount: data.repoCount ?? 0,
      totalDiskUsage: typeof data.totalDiskUsage === 'number' ? data.totalDiskUsage : 0,
      mainLicense: data.mainLicense ?? 'n/a',
      languages: Array.isArray(data.languages) ? data.languages : [],
      updatedAt: data.updatedAt,
    }
    fetchAt = Date.now()
    return cache
  } catch (error) {
    console.error('Failed to fetch GitHub stats, using default:', error)
    return cache ?? EMPTY_STATS
  }
}

const stats = await getStats()

const {
  totalCommits,
  totalFollowers,
  streak,
  repoCount,
  totalDiskUsage,
  mainLicense,
  languages,
  updatedAt,
} = stats

const diskMB = Math.round(totalDiskUsage / 1024)

const githubStats = [
  { name: 'Followers', value: totalFollowers },
  { name: 'Commit Streak', value: `${streak} days` },
  { name: 'All-time Commits', value: totalCommits },
  { name: 'Repositories', value: repoCount },
  { name: 'Disk Usage', value: `${diskMB} MB` },
  { name: 'Main License', value: mainLicense },
]
---

<PageLayout title={STATS.TITLE} description={STATS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>

      <h1 class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconStats} />
        </div>
        Statistics
      </h1>

      {STATS.INTRO!.map((paragraph) => <p>{paragraph}</p>)}

      <div class="space-y-12">
        <!-- Garden Metrics Section -->
        <section class="space-y-4">
          <h2
            class="border-border-light text-ink-light dark:text-ink-dark border-b pb-2 font-semibold"
          >
            Digital Garden
          </h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            {
              gardenStats.map((stat) => (
                <div class="space-y-1">
                  <div class="text-mute-light dark:text-mute-dark text-[10px] tracking-wider uppercase">
                    {stat.name}
                  </div>
                  <div class="text-primary font-mono text-2xl font-bold">{stat.count}</div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Activity Section -->
        <section class="space-y-4">
          <h2
            class="border-border-light text-ink-light dark:text-ink-dark border-b pb-2 font-semibold"
          >
            GitHub Activity
          </h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
            {
              githubStats.map((stat) => (
                <div class="space-y-1">
                  <div class="text-mute-light dark:text-mute-dark text-sm tracking-wider">
                    {stat.name}
                  </div>
                  <div class="text-primary font-mono text-2xl font-bold">{stat.value}</div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Languages Section -->
        <section class="space-y-6">
          <h2
            class="border-border-light text-ink-light dark:text-ink-dark border-b pb-2 font-semibold"
          >
            Language Distribution
          </h2>
          <div class="space-y-8">
            {
              languages.map((lang: Language) => (
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <h3 class="text-ink-light dark:text-ink-dark text-sm font-medium">
                      {lang.name}
                    </h3>
                  </div>
                  <ProgressBar percentage={parseFloat(lang.percentage)} />
                </div>
              ))
            }
          </div>
          <div class="text-mute-light dark:text-mute-dark text-sm italic">
            {updatedAt && <>Last sync: {new Date(updatedAt).toLocaleDateString('en-GB')} · </>}
            Source:{' '}
            <Link href="https://github.com/aadnanmt/meesync" external>meesync</Link>
          </div>
        </section>
      </div>

      <div class="pt-10">
        <NowPlaying />
      </div>
    </div>
  </Container>
</PageLayout>
