---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import Link from '@components/Link.astro'
import TimeStatus from '@components/TimeStatus.astro'
import { SITE, SOCIALS, CONTACT } from '@consts'
import { getIcon, IconEmail } from '@lib/icon'
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <h1 class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconEmail} />
        </div>
        Connect
      </h1>
      <p>Best ways to reach me, depending on what you need.</p>

      <div>
        <TimeStatus />
      </div>

      <div class="space-y-12">
        <section class="space-y-4">
          <h2 class="text-ink-light dark:text-ink-dark font-semibold">Professional Inquiries</h2>
          <p class="text-mute-light dark:text-mute-dark text-sm">
            For technical discussions or proposals. Shoot me an email
          </p>
          <div class="flex items-center gap-2">
            <div
              class="fill-mute-light dark:fill-mute-dark text-mute-light dark:text-mute-dark size-4"
            >
              <Fragment set:html={IconEmail} />
            </div>
            <!--
              email_off markers stop Cloudflare Email Obfuscation (zone feature,
              default-on) from masking this address:
https://developers.cloudflare.com/waf/tools/scrape-shield/email-address-obfuscation/#prevent-cloudflare-from-obfuscating-email
            -->
            <Link href={`mailto:${SITE.EMAIL}`} external>
              <span set:html={`<!--email_off-->${SITE.EMAIL}<!--/email_off-->`} />
            </Link>
          </div>
        </section>

        <section class="space-y-6">
          <h2 class="text-ink-light dark:text-ink-dark font-semibold">Social Presence</h2>
          <p class="text-mute-light dark:text-mute-dark text-sm">
            Track my experiments, follow the journey, or just reach out.
          </p>

          <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {
              SOCIALS.map((SOCIAL) => {
                const isActive = SOCIAL.status === 'active'
                const isInactive = SOCIAL.status === 'inactive'
                return (
                  <li
                    class={`group border-border-soft-light flex flex-col gap-1 border-l-2 pl-4 dark:border-border-soft-dark${isInactive ? ' pointer-events-none' : ''}`}
                  >
                    <div class="flex items-center gap-2">
                      <div class="fill-mute-light dark:fill-mute-dark text-mute-light dark:text-mute-dark size-4">
                        <Fragment set:html={getIcon(SOCIAL.NAME)} />
                      </div>
                      {isInactive ? (
                        <span class="text-mute-light dark:text-mute-dark font-medium lowercase">
                          {SOCIAL.NAME}
                        </span>
                      ) : (
                        <Link
                          href={SOCIAL.HREF}
                          external
                          class="text-ink-light dark:text-ink-dark font-medium lowercase"
                        >
                          {SOCIAL.NAME}
                        </Link>
                      )}
                      {isActive && (
                        <span class="bg-primary/10 text-primary-soft-light dark:text-primary rounded-full px-2 py-0.5 text-[10px] tracking-wider uppercase">
                          active
                        </span>
                      )}
                      {isInactive && (
                        <span class="bg-mute-light/10 text-mute-light dark:bg-mute-dark/10 dark:text-mute-dark rounded-full px-2 py-0.5 text-[10px] tracking-wider uppercase">
                          inactive
                        </span>
                      )}
                    </div>
                    <span class="text-mute-light dark:text-mute-dark text-xs">
                      {SOCIAL.DESCRIPTION}
                    </span>
                  </li>
                )
              })
            }
          </ul>
          <p class="text-mute-light dark:text-mute-dark text-xs">
            I'm currently optimize for <strong>deep work.</strong> Only via <strong>GitHub</strong> /
            <strong>Codeberg</strong> for technical collab, or <strong>Telegram</strong> for direct message.
          </p>
        </section>

        <section class="space-y-4">
          <h2 class="text-ink-light dark:text-ink-dark font-semibold">Support my work</h2>
          <p class="text-mute-light dark:text-mute-dark text-sm">
            If you find my digital garden or open-source projects useful, consider supporting my
            research and maintenance.
          </p>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="border-border-light space-y-2 rounded-md border p-4">
              <span
                class="text-mute-light dark:text-mute-dark text-xs font-semibold tracking-wider uppercase"
                >Fiat / Traditional</span
              >
              <div class="flex items-center gap-2">
                <div
                  class="fill-mute-light dark:fill-mute-dark text-mute-light dark:text-mute-dark size-4"
                >
                  <Fragment set:html={getIcon('ko-fi')} />
                </div>
                <Link href="/kf" external class="text-ink-light dark:text-ink-dark font-medium">
                  Ko-fi
                </Link>
              </div>
              <p class="text-mute-light dark:text-mute-dark text-xs">
                Fast, 0% platform fee, supports PayPal & Cards.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </Container>
</PageLayout>
