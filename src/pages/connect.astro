---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import BackToPrev from "@components/BackToPrev.astro"
import Link from "@components/Link.astro"
import TimeStatus from "@components/TimeStatus.astro"
import { SITE, SOCIALS, CONTACT } from "@consts"
import { getIcon, IconEmail } from "@lib/iconSystem"
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <div
        class="flex items-center gap-2 font-semibold text-black dark:text-white"
      >
        <div class="size-5 fill-current">
          <Fragment set:html={IconEmail} />
        </div>
        Connect
      </div>
      <p>Best ways to reach me, depending on what you need.</p>

      <div>
        <TimeStatus />
      </div>

      <div class="space-y-12">
        <section class="space-y-4">
          <h4 class="font-semibold text-black dark:text-white">
            Professional Inquiries
          </h4>
          <p class="text-mute-light dark:text-mute-dark text-sm">
            For collaboration, project proposals, or deep technical discussions,
            email is the most reliable way to reach me.
          </p>
          <div class="flex items-center gap-2">
            <div
              class="fill-mute-light dark:fill-mute-dark text-mute-light dark:text-mute-dark size-4"
            >
              <Fragment set:html={IconEmail} />
            </div>
            <Link href={`mailto:${SITE.EMAIL}`} external>
              {SITE.EMAIL}
            </Link>
          </div>
        </section>

        <section class="space-y-6">
          <h4 class="font-semibold text-black dark:text-white">
            Social Presence
          </h4>
          <p class="text-mute-light dark:text-mute-dark text-sm">
            Follow my journey, see my experiments, or just reach out for a quick
            chat.
          </p>

          <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {
              SOCIALS.map((SOCIAL) => {
                // Three states: ACTIVE = linked + badge, BALANCED = linked
                // but exclude from active count, INACTIVE = not linked
                const isExcluded = SOCIAL.BALANCED
                const isInactive = !SOCIAL.ACTIVE && !SOCIAL.BALANCED
                return (
                  <li
                    class={`group border-border-soft-light flex flex-col gap-1 border-l-2 pl-4 dark:border-border-soft-dark${isInactive ? " pointer-events-none opacity-50" : ""}`}
                  >
                    <div class="flex items-center gap-2">
                      <div class="fill-mute-light dark:fill-mute-dark text-mute-light dark:text-mute-dark size-4">
                        <Fragment set:html={getIcon(SOCIAL.NAME)} />
                      </div>
                      {SOCIAL.ACTIVE || isExcluded ? (
                        <Link
                          href={SOCIAL.HREF}
                          external
                          class="font-medium text-black lowercase dark:text-white"
                        >
                          {SOCIAL.NAME}
                        </Link>
                      ) : (
                        <span class="font-medium text-black lowercase dark:text-white">
                          {SOCIAL.NAME}
                        </span>
                      )}
                      {SOCIAL.ACTIVE && (
                        <span class="bg-primary/10 text-primary-soft-light dark:text-primary rounded-full px-2 py-0.5 text-[10px] tracking-wider uppercase">
                          active
                        </span>
                      )}
                      {isInactive && (
                        <span class="bg-mute-light/10 text-mute-light dark:bg-mute-dark/10 dark:text-mute-dark rounded-full px-2 py-0.5 text-[10px] tracking-wider uppercase">
                          inactive
                        </span>
                      )}
                    </div>
                    <span class="text-mute-light dark:text-mute-dark text-xs">
                      {SOCIAL.DESCRIPTION}
                    </span>
                  </li>
                )
              })
            }
          </ul>
          <p class="text-mute-light dark:text-mute-dark text-xs">
            I'm currently optimize for <strong>deep work.</strong> Only via <strong
              >GitHub</strong
            > / <strong>Codeberg</strong> for technical collab, or <strong
              >Telegram</strong
            > for direct message.
          </p>
        </section>

        <section class="space-y-4">
          <h4 class="font-semibold text-black dark:text-white">
            Support my work
          </h4>
          <p class="text-mute-light dark:text-mute-dark text-sm">
            If you find my digital garden or open-source projects useful,
            consider supporting my research and maintenance.
          </p>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div
              class="space-y-2 border border-black/10 p-4 dark:border-white/10"
            >
              <span
                class="text-mute-light dark:text-mute-dark text-xs font-semibold tracking-wider uppercase"
                >Fiat / Traditional</span
              >
              <div class="flex items-center gap-2">
                <div
                  class="fill-mute-light dark:fill-mute-dark text-mute-light dark:text-mute-dark size-4"
                >
                  <Fragment set:html={getIcon("ko-fi")} />
                </div>
                <Link
                  href="/kf"
                  external
                  class="font-medium text-black dark:text-white"
                >
                  Ko-fi
                </Link>
              </div>
              <p class="text-mute-light dark:text-mute-dark text-xs">
                Fast, 0% platform fee, supports PayPal & Cards.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </Container>
</PageLayout>
