---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import { IconFocus } from '@lib/icon'
import { FOCUS } from '@consts'
import YearProgress from '@components/YearProgress.astro'
import ProgressBar from '@components/ProgressBar.astro'
import { MYFOCUS } from '@data/focus'
---

<PageLayout title={FOCUS.TITLE} description={FOCUS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>

      <h1 class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconFocus} />
        </div>
        Focus
      </h1>

      {FOCUS.INTRO!.map((paragraph) => <p>{paragraph}</p>)}

      <div>
        <YearProgress />
      </div>

      <div class="space-y-8">
        {
          MYFOCUS.map((item) => (
            <section class="space-y-4">
              <div class="flex items-center justify-between">
                <h2 class="text-ink-light dark:text-ink-dark font-semibold">{item.title}</h2>
              </div>
              <ProgressBar percentage={item.percentage} />
              <p class="text-sm opacity-70">{item.description}</p>
            </section>
          ))
        }
      </div>

      <div
        class="border-border-light text-mute-light dark:text-mute-dark mt-12 border-t pt-8 text-xs italic"
      >
        Last synced from my brain: {new Date().toLocaleDateString('en-GB')}
      </div>
    </div>
  </Container>
</PageLayout>
