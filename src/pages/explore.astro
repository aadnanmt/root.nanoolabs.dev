---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import { IconHome } from '@lib/icon'
import { IconArrowRight } from '@lib/icon'
import { EXPLORE } from '@consts'
import { EXPLORE_PAGES, MAIN_PAGES } from '@data/pages'

const GROUPS: { key: 'content' | 'live' | 'identity'; label: string }[] = [
  { key: 'content', label: 'Garden' },
  { key: 'live', label: 'Live' },
  { key: 'identity', label: 'Identity' },
]
---

<PageLayout title={EXPLORE.TITLE} description={EXPLORE.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/"> Back to home </BackToPrev>

      <h1 class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconHome} />
        </div>
        Explore
      </h1>

      {EXPLORE.INTRO!.map((paragraph) => <p>{paragraph}</p>)}

      <div class="space-y-12">
        {
          GROUPS.map(({ key, label }) => (
            <section class="space-y-6">
              <h2 class="border-accent text-ink-light dark:text-ink-dark flex items-center gap-2 border-l-2 py-1 pl-4 font-semibold">
                <span>{label}</span>
              </h2>
              <ul class="flex flex-col space-y-4">
                {[...EXPLORE_PAGES, ...MAIN_PAGES]
                  .filter((page) => page.group === key)
                  .map((page) => (
                    <li>
                      <a
                        href={page.href}
                        class="group hover:border-accent/40 dark:hover:border-accent/40 active:border-accent/40 dark:active:border-accent/40 border-border-light focus-visible:border-accent/40 dark:focus-visible:border-accent/40 relative flex flex-nowrap rounded-md border px-4 py-3.5 pr-10 transition-colors"
                      >
                        <div class="flex flex-1 flex-col gap-1 space-y-1 truncate">
                          <div class="text-ink-light dark:text-ink-dark font-semibold">
                            {page.name}
                          </div>
                          <div class="text-mute-light dark:text-mute-dark truncate text-sm">
                            {page.desc}
                          </div>
                        </div>
                        <span class="group-hover:stroke-accent dark:group-hover:stroke-accent group-active:stroke-accent dark:group-active:stroke-accent absolute top-1/2 right-2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2">
                          <Fragment set:html={IconArrowRight} />
                        </span>
                      </a>
                    </li>
                  ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
