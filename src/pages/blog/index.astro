---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import ArrowCard from '@components/ArrowCard.astro'
import PageTitle from '@components/PageTitle.astro'
import PageIntro from '@components/PageIntro.astro'
import { BLOG } from '@consts'
import BackToPrev from '@components/BackToPrev.astro'
import SectionTitle from '@components/SectionTitle.astro'
import { getPublishedEntries, groupByYear } from '@lib/content'

const posts = groupByYear(getPublishedEntries(await getCollection('blog')))
const years = Object.keys(posts)
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev> Back to home </BackToPrev>
      <PageTitle title={BLOG.TITLE} />
      <PageIntro intro={BLOG.INTRO!} />
      <div class="space-y-4">
        {
          years.map((year) => (
            <section class="space-y-4">
              <SectionTitle title={year} />
              <div>
                <ul class="flex flex-col gap-3">
                  {posts[year].map((post) => (
                    <li>
                      <ArrowCard entry={post} />
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
