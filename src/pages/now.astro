---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import FormattedDate from '@components/FormattedDate.astro'
import { IconNow } from '@lib/icon'
import NowPlaying from '@components/NowPlaying.astro'
import Link from '@components/Link.astro'
import Mood from '@components/Mood.astro'
import Weather from '@components/Weather.astro'
import { gitDate } from '@lib/utils'

const allNowEntries = await getCollection('now')
const sortedEntries = allNowEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const latestEntry = sortedEntries[0]
const history = sortedEntries.slice(1)

const { Content } = await latestEntry.render()
const lastUpdated = gitDate(`src/content/now/${latestEntry.id}`)
---

<PageLayout title={latestEntry.data.title} description={latestEntry.data.description}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>

      <h1 class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconNow} />
        </div>
        Now
      </h1>

      <div class="text-mute-light dark:text-mute-dark text-sm italic">
        Last synced with Git: <FormattedDate date={lastUpdated || latestEntry.data.date} />
      </div>

      <p class="text-md text-mute-light dark:text-mute-dark">
        What's a /now page? Read more about it
        <Link href="https://nownownow.com/about" external>here</Link>.
      </p>

      <div class="space-y-4">
        <Mood />
        <NowPlaying />
        <Weather />
      </div>

      <article>
        <Content />
      </article>

      {
        history.length > 0 && (
          <div class="border-border-light space-y-4 border-t pt-10">
            <h2 class="text-ink-light dark:text-ink-dark text-xl font-semibold">
              Previous Updates
            </h2>
            <ul class="space-y-2">
              {history.map((entry) => (
                <li class="text-sm">
                  <span class="text-mute-light dark:text-mute-dark">
                    <FormattedDate date={entry.data.date} />
                  </span>
                  {' — '}
                  <span class="italic">{entry.data.description}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Container>
</PageLayout>
