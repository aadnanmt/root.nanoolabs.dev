---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import Link from '@components/Link.astro'
import BackToPrev from '@components/BackToPrev.astro'
import PageTitle from '@components/PageTitle.astro'
import PageIntro from '@components/PageIntro.astro'
import { CREDITS as CREDITS_META } from '@consts'
import { CREDITS } from '@data/credits'
---

<PageLayout title={CREDITS_META.TITLE} description={CREDITS_META.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <PageTitle title={CREDITS_META.TITLE} />
      <PageIntro intro={CREDITS_META.INTRO!} />
      <ul class="flex flex-col space-y-8">
        {
          CREDITS.map((credit) => (
            <li>
              <div class="space-y-1">
                <Link
                  href={credit.HREF}
                  external
                  class="text-ink-light dark:text-ink-dark font-semibold"
                >
                  {credit.NAME}
                </Link>
                <div class="text-mute-light dark:text-mute-dark text-sm">{credit.DESCRIPTION}</div>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="text-sm italic">And special thanks to you for visiting this site.</p>
    </div>
  </Container>
</PageLayout>
