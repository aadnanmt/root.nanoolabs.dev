---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import { IconUses } from '@lib/iconSystem'
import { USES } from '@consts'
import { Content } from '@data/uses.md'
---

<PageLayout title={USES.TITLE} description={USES.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>

      <div class="text-ink-light dark:text-ink-dark flex items-center gap-2 font-semibold">
        <div class="size-5 fill-current">
          <Fragment set:html={IconUses} />
        </div>
        Uses
      </div>
      {USES.INTRO!.map((paragraph) => <p>{paragraph}</p>)}

      <article>
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>
