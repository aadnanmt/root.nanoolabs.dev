---
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import BackToPrev from '@components/BackToPrev.astro'
import PageTitle from '@components/PageTitle.astro'
import PageIntro from '@components/PageIntro.astro'
import { gitDate } from '@lib/utils'
import FormattedDate from '@components/FormattedDate.astro'
import { USES } from '@consts'
import { Content } from '@data/uses.md'

const lastUpdated = gitDate('src/data/uses.md')
---

<PageLayout title={USES.TITLE} description={USES.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <PageTitle title={USES.TITLE} />
      <PageIntro intro={USES.INTRO!} />

      {
        lastUpdated && (
          <div class="text-mute-light dark:text-mute-dark text-sm italic">
            Last updated: <FormattedDate date={lastUpdated} />
          </div>
        )
      }

      <article>
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>
