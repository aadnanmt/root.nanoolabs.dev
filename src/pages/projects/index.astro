---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import ArrowCard from '@components/ArrowCard.astro'
import { PROJECTS } from '@consts'
import BackToPrev from '@components/BackToPrev.astro'
import { IconProjects } from '@lib/iconSystem'

const allProjects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const nanooProjects = allProjects.filter((p) => p.data.category === 'nanoo')
const personalProjects = allProjects.filter((p) => p.data.category === 'personal')
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
	<Container>
		<div class="space-y-10">
			<BackToPrev> Back to home </BackToPrev>
			<div class="flex items-center gap-2 font-semibold text-black dark:text-white">
				<div class="size-5 fill-current">
					<Fragment set:html={IconProjects} />
				</div>
				Projects
			</div>
			{PROJECTS.INTRO!.map((paragraph) => <p>{paragraph}</p>)}
			{
				nanooProjects.length > 0 && (
					<>
						<h3 class="mt-12 font-semibold text-black dark:text-white">Nanoo</h3>
						<ul class="flex flex-col gap-3">
							{nanooProjects.map((project) => (
								<li>
									<ArrowCard entry={project} />
								</li>
							))}
						</ul>
					</>
				)
			}
			<h3 class="mt-12 font-semibold text-black dark:text-white">Personal</h3>
			<ul class="flex flex-col gap-3">
				{
					personalProjects.map((project) => (
						<li>
							<ArrowCard entry={project} />
						</li>
					))
				}
			</ul>
		</div>
	</Container>
</PageLayout>
