---
import { getCollection } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Container from '@components/Container.astro'
import ArrowCard from '@components/ArrowCard.astro'
import { PROJECTS } from '@consts'
import BackToPrev from '@components/BackToPrev.astro'
import PageTitle from '@components/PageTitle.astro'
import PageIntro from '@components/PageIntro.astro'

const allProjects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const nanooProjects = allProjects.filter((p) => p.data.category === 'nanoo')
const personalProjects = allProjects.filter((p) => p.data.category === 'personal')
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev> Back to home </BackToPrev>
      <PageTitle title={PROJECTS.TITLE} />
      <PageIntro intro={PROJECTS.INTRO!} />
      {
        nanooProjects.length > 0 && (
          <>
            <h2 class="text-ink-light dark:text-ink-dark mt-12 font-semibold">Nanoo</h2>
            <ul class="flex flex-col gap-3">
              {nanooProjects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h2 class="text-ink-light dark:text-ink-dark mt-12 font-semibold">Personal</h2>
      <ul class="flex flex-col gap-3">
        {
          personalProjects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
