---
export const prerender = true
import { getCollection, type CollectionEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import FormattedDate from "@components/FormattedDate.astro"
import { readingTime, gitDate } from "@lib/utils"
import BackToPrev from "@components/BackToPrev.astro"
import { SITE, LICENSE } from "@consts"
import Link from "@components/Link.astro"

type Entry =
  | CollectionEntry<"blog">
  | CollectionEntry<"projects">
  | CollectionEntry<"commands">

export async function getStaticPaths() {
  const COLLECTIONS = ["blog", "projects", "commands"] as const
  const paths: {
    params: { collection: string; slug: string | undefined }
    props: { collection: string; entry: Entry }
  }[] = []

  for (const name of COLLECTIONS) {
    // draft filter: exclude entries where `draft` exists AND is true
    // the `"draft" in e.data` guard lets collections without a draft
    // field (e.g commands) pass through without TypeError
    const entries = (await getCollection(name)).filter(
      (e) => !("draft" in e.data && e.data.draft)
    )
    for (const entry of entries) {
      paths.push({
        params: { collection: name, slug: entry.slug },
        props: { collection: name, entry },
      })
    }
  }
  return paths
}

const { collection, entry } = Astro.props as {
  collection: string
  entry: {
    id: string
    slug: string
    body: string
    render: Entry["render"]
    data: {
      title: string
      description: string
      date: Date
      category?: string
      demoURL?: string
      repoURL?: string
      tags?: string[]
    }
  }
}

const { Content } = await entry.render()
const lastUpdated = gitDate(`${collection}/${entry.id}`)
const hasDate = collection !== "commands"
const useProse = collection === "commands"
const bigTitle = collection === "commands"
const hasDemo = collection === "projects"
const ogImage = `/content/${collection}/${entry.slug}/cover.webp`
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={ogImage}
>
  <Container>
    <div>
      <BackToPrev href={`/${collection}`}>
        {" "}Back to {collection}{" "}
      </BackToPrev>
    </div>
    <div class="my-10 space-y-1">
      <div class="flex flex-wrap items-center gap-1.5">
        {
          hasDate ? (
            <>
              <div class="font-base text-sm">
                <FormattedDate date={entry.data.date} />
              </div>
              <>
                &bull;
                <div class="font-base text-sm">{readingTime(entry.body)}</div>
              </>
            </>
          ) : (
            <div class="font-base text-sm">
              Category:{" "}
              <span class="text-primary font-semibold">
                {entry.data.category}
              </span>
            </div>
          )
        }
        {
          lastUpdated && (
            <>
              &bull;
              <div class="font-base text-sm italic opacity-75">
                Last updated: <FormattedDate date={lastUpdated} />
              </div>
            </>
          )
        }
      </div>
      <div
        class={`font-semibold text-black dark:text-white${
          bigTitle ? " text-3xl" : " text-2xl"
        }`}
      >
        {entry.data.title}
      </div>
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {entry.data.tags.map((tag) => (
              <span class="text-body-light border border-black/10 px-2 py-0.5 font-mono text-xs dark:border-white/10">
                {tag}
              </span>
            ))}
          </div>
        )
      }
      {
        hasDemo && (entry.data.demoURL || entry.data.repoURL) && (
          <nav class="flex gap-1">
            {entry.data.demoURL && (
              <Link href={entry.data.demoURL} external>
                demo
              </Link>
            )}
            {entry.data.demoURL && entry.data.repoURL && <span>/</span>}
            {entry.data.repoURL && (
              <Link href={entry.data.repoURL} external>
                repo
              </Link>
            )}
          </nav>
        )
      }
    </div>
    <article
      class={`${useProse ? " prose prose-neutral max-w-none dark:prose-invert" : ""}`}
    >
      <Content />
    </article>
    <div class="mt-24 border-t border-black/10 pt-10 dark:border-white/10">
      <p class="text-sm opacity-75">
        This content is licensed under
        <Link href={LICENSE.URL} external class="decoration-accent/50">
          {LICENSE.NAME}
        </Link>
        .<span class="mx-1 opacity-50">|</span>
        <Link
          href={`${SITE.REPO}/edit/main/src/content/${collection}/${entry.id}`}
          external
          class="decoration-accent/50"
        >
          Edit this page
        </Link>
      </p>
    </div>
  </Container>
</PageLayout>
