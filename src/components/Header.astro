---
import Link from '@components/Link.astro'
import { SITE, SOCIALS } from '@consts'
import { IconGithub } from '@lib/iconSystem'
---

<header class="fixed top-5 right-0 left-0 z-50 flex items-center justify-center">
	<div
		class="bg-canvas-soft-light/70 dark:bg-canvas-soft-dark/50 dark:border-primary/20 border-border-light mx-4 flex h-14 w-full max-w-screen-md items-center justify-between gap-2 rounded-md border px-4 saturate-200 backdrop-blur-md sm:mx-0 sm:gap-5 sm:px-8"
	>
		<Link href={'/'} underline={false}>
			<div
				class="text-ink-light dark:text-ink-dark flex shrink-0 items-center font-mono font-bold tracking-wider"
			>
				{SITE.NAME}
			</div>
		</Link>

		<nav class="flex items-center gap-1.5 text-sm font-medium sm:gap-1">
			<Link href="/blog"> blog </Link>
			<span class="hidden opacity-20 sm:block">
				{`/`}
			</span>
			<Link href="/now"> now </Link>
			<span class="hidden opacity-20 sm:block">
				{`/`}
			</span>
			<Link href="/projects"> projects </Link>
			<span class="hidden opacity-20 sm:block">
				{`/`}
			</span>
			<Link href="/explore"> explore </Link>

			<div class="bg-ink-light/10 dark:bg-ink-dark/20 mr-1 ml-1 h-4 w-px sm:ml-2"></div>
			<Link
				href={SOCIALS.find((s) => s.NAME === 'github')?.HREF || SITE.REPO}
				external
				aria-label="GitHub"
				underline={false}
				class="flex shrink-0 items-center"
			>
				<div class="fill-mute-light dark:fill-mute-dark size-5">
					<Fragment set:html={IconGithub} />
				</div>
			</Link>
		</nav>
	</div>
</header>
