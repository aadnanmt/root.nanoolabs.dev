---
import { getWeather } from '@lib/weather'

const { temp, condition, error } = await getWeather()

// Silent fail
if (error || !temp) {
  return null
}

const emoji = temp >= 30 ? '☀️' : temp >= 20 ? '🌤️' : temp >= 10 ? '☁️' : '❄️'
---

<div class="border-border-light flex items-center gap-4 rounded-md border p-4">
  <div
    class="bg-ink-light/5 dark:bg-ink-dark/5 flex h-12 w-12 shrink items-center justify-center rounded-md text-2xl"
  >
    {emoji}
  </div>
  <div class="flex flex-col gap-0.5 overflow-hidden">
    <span
      class="text-mute-light dark:text-mute-dark text-xs font-semibold tracking-widest uppercase"
    >
      Current weather
    </span>
    <span class="text-ink-light dark:text-ink-dark truncate text-sm font-semibold">
      {temp}°C
    </span>
    <span class="text-mute-light dark:text-mute-dark truncate text-xs">{condition}</span>
  </div>
</div>
