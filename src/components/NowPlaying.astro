---
import { getNowPlaying } from '@lib/lastfm'
import { IconMusic } from '@lib/icon'
import { timeAgo } from '@lib/utils'

const { track, error } = await getNowPlaying()

// Silent fail
if (error || !track) {
  return null
}

const lastPlayed = track.timestamp ? timeAgo(new Date(track.timestamp * 1000)) : ''
---

<div class="border-border-light flex items-center gap-4 rounded-md border p-4">
  <div
    class="bg-ink-light/5 dark:bg-ink-dark/5 relative flex h-12 w-12 shrink items-center justify-center rounded-md"
  >
    {
      track.image ? (
        <img
          src={track.image}
          alt={`Album cover for ${track.name} by ${track.artist}`}
          class="h-full w-full rounded-md object-cover"
        />
      ) : (
        <div class="text-ink-light/50 dark:text-ink-dark/50 flex h-full w-full items-center justify-center rounded-md">
          <Fragment set:html={IconMusic} />
        </div>
      )
    }
    {
      track.nowPlaying && (
        <span class="absolute -top-1 -right-1 flex h-3 w-3">
          <span class="bg-primary absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" />
          <span class="bg-primary-deep-light dark:bg-primary relative inline-flex h-3 w-3 rounded-full" />
        </span>
      )
    }
  </div>
  <div class="flex flex-col overflow-hidden">
    <span
      class="text-mute-light dark:text-mute-dark text-xs font-semibold tracking-widest uppercase"
    >
      {track.nowPlaying ? 'Now Playing' : `Last Played - ${lastPlayed}`}
    </span>
    <span class="text-ink-light dark:text-ink-dark truncate text-sm font-semibold">
      {track.name}
    </span>
    <span class="text-mute-light dark:text-mute-dark truncate text-xs">{track.artist}</span>
  </div>
</div>
