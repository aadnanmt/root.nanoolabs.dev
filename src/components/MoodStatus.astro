---
import { getMood } from '@lib/imood'
import { getEmoji } from '@lib/emoji'

const { mood } = await getMood()
if (!mood) return null
---

<div
	class="border-border-light inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs font-medium"
>
	<span aria-hidden="true">{getEmoji(mood)}</span>
	<span>{mood}</span>
</div>
