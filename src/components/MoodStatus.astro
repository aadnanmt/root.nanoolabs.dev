---
import { getMood } from '@lib/imood'
import { getEmoji } from '@lib/emoji'

const { mood } = await getMood()
if (!mood) return null
---

<div
	class="inline-flex items-center gap-1.5 border border-black/10 px-2.5 py-1 text-xs font-medium dark:border-white/10"
>
	<span aria-hidden="true">{getEmoji(mood)}</span>
	<span>{mood}</span>
</div>
