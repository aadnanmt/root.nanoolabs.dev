---
import { IconArrowLeft } from "@lib/iconSystem"
---

<button
  id="back-to-top"
  class="group hover:border-accent/40 dark:hover:border-accent/40 relative flex w-fit flex-nowrap border border-black/25 py-1.5 pr-3 pl-8 transition-colors duration-300 ease-in-out dark:border-white/30"
>
  <span
    class="group-hover:stroke-accent dark:group-hover:stroke-accent absolute top-1/2 left-2 size-4 -translate-y-1/2 rotate-90 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out"
    ><Fragment set:html={IconArrowLeft} /></span
  >
  <div class="text-sm">Back to top</div>
</button>
